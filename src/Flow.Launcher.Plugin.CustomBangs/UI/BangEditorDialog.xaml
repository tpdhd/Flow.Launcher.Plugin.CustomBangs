<Window
    x:Class="Flow.Launcher.Plugin.CustomBangs.UI.BangEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="700"
    Height="520"
    MinWidth="560"
    MinHeight="420"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="EditorInputBackground" Color="#FF25272B" />
        <SolidColorBrush x:Key="EditorInputForeground" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="EditorBorderBrush" Color="#FF686B70" />
        <SolidColorBrush x:Key="EditorMutedForeground" Color="#FFB6B8BD" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource Color00B}" />
            <Setter Property="Foreground" Value="{DynamicResource Color05B}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Color05B}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color03B}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Resources>

    <Border Padding="18" Background="{DynamicResource Color01B}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Foreground="{DynamicResource Color05B}" Text="Command" />
                <TextBox x:Name="KeywordTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" />
                <TextBlock x:Name="AliasLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Foreground="{DynamicResource Color05B}" Text="Alias target" />
                <TextBox x:Name="AliasTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
            </Grid>

            <StackPanel x:Name="GroupPanel" Grid.Row="1">
                <TextBlock Margin="0,2,0,6" FontWeight="SemiBold" Foreground="{DynamicResource Color05B}" Text="Member shortcuts" />
                <TextBox x:Name="GroupMembersTextBox" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Color04B}"
                    Text="Enter existing shortcuts separated by commas. Example: asd, ede, ali. With command shop1, typing shop1 headphones opens every member search with the same query."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="RegularBangPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Foreground="{DynamicResource Color05B}" Text="Default URL" />
                    <TextBox x:Name="DefaultUrlTextBox" Grid.Column="1" Margin="0,0,0,12" />
                </Grid>
                <CheckBox x:Name="DontEncodeCheckBox" Grid.Row="1" Margin="120,0,0,12" Content="Do not encode the query (raw replacement)" />
                <TextBlock Grid.Row="2" Margin="0,0,0,6" Foreground="{DynamicResource Color05B}" Text="Search target URLs — every %s is replaced by the query" />
                <DataGrid
                    x:Name="UrlsDataGrid"
                    Grid.Row="3"
                    AutoGenerateColumns="False"
                    Background="{DynamicResource Color00B}"
                    BorderBrush="{DynamicResource Color03B}"
                    CanUserAddRows="False"
                    Foreground="{DynamicResource Color05B}"
                    ItemsSource="{Binding UrlRows}"
                    RowBackground="{DynamicResource Color01B}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="URL" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="104" Click="AddUrl_Click" Content="Add target" />
                    <Button Width="120" Margin="8,0,0,0" Click="RemoveUrl_Click" Content="Remove target" />
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="90" IsCancel="True" Content="Cancel" />
                    <Button Width="90" Margin="8,0,0,0" IsDefault="True" Click="Save_Click" Content="Save" />
                </StackPanel>
                <TextBlock x:Name="ValidationTextBlock" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
